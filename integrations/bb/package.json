{
  "name": "bb-plugin-highwater",
  "version": "0.5.7",
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": {
    "bb": ">=0.49",
    "bbPluginSdk": ">=0.6.132"
  },
  "bb": {
    "name": "Highwater [Experimental]",
    "description": "See how a coding-agent thread uses its context window, call by call.",
    "branding": {
      "icon": "./assets/icon.svg",
      "experimental_icons": {
        "gauge": "./assets/gauge.svg"
      }
    },
    "server": "./server.ts",
    "host": "./host.ts",
    "app": "./app.tsx",
    "skills": []
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:release": "vitest run --config vitest.release.config.ts",
    "build": "bb plugin build",
    "format": "prettier --write \"*.{ts,tsx,json}\" \"{app,components,host,lib,server,tests}/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"*.{ts,tsx,json}\" \"{app,components,host,lib,server,tests}/**/*.{ts,tsx}\""
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.5.0",
    "semver": "^7.7.0",
    "tar-stream": "^3.2.2",
    "yauzl": "^3.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.6.132",
    "@radix-ui/react-tooltip": "1.2.8",
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/semver": "^7.7.0",
    "@types/tar-stream": "^3.1.5",
    "@types/yauzl": "^3.4.0",
    "bb-app": "0.49.0",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cron-parser": "^5.5.0",
    "hono": "^4.13.16",
    "jsdom": "^27.4.0",
    "prettier": "^3.9.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "typescript": "5.9.2",
    "vitest": "3.2.7"
  }
}

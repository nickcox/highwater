{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "strict": true,
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "types": ["node", "vitest/globals"]
  },
  "include": [
    "*.ts",
    "*.tsx",
    "app/**/*",
    "components/**/*",
    "host/**/*",
    "lib/**/*",
    "server/**/*",
    "tests/**/*"
  ]
}
